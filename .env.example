# Exchange API credentials
EXCHANGE=bybit
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading parameters
INITIAL_BALANCE=200
TARGET_BALANCE=1200
MAX_RISK_PER_TRADE=0.05
MAX_LEVERAGE=10
TIMEFRAMES=1d,4h,1h

# Symbols to scan (comma-separated)
SYMBOLS=SOL/USDT,XRP/USDT,OP/USDT,ETH/USDT,BTC/USDT,AVAX/USDT,DOGE/USDT,ADA/USDT

# Bot mode: live / paper
MODE=paper

# Logging
LOG_LEVEL=INFO
